# Number of log entries to generate. Use 0 for infinite generation.
LOG_COUNT = 10

# Server name displayed in the log entries.
SERVER_NAME = "web1"

# Log format to use for generation. Options: CLF, RFC5424, JSON, STOCKTX
GENERATOR_FORMAT = "CLF"

# Time to wait between log entries in seconds. Can be a decimal value for sub-second precision.
MINIMUM_WAIT = 0.1
MAXIMUM_WAIT = 0.2

# OpenTelemetry Collector endpoint for OTLP logs. Set to "none" to disable OTel logging. Exporter uses gRPC (default port 4317).
OTEL_EXPORTER_OTLP_ENDPOINT = "none"